# OpenRemote Infrastructure Configuration
# Copy to .env and fill in your values.
# Never commit .env to version control.

# Coordination server
COORDINATION_PORT=8080

# PostgreSQL
POSTGRES_USER=openremote
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=openremote

# Logging
RUST_LOG=info
OPENREMOTE_LOG_FORMAT=json

# TURN server
TURN_REALM=openremote.dev
TURN_SECRET=change-me-in-production

# TLS (for production — configure via reverse proxy or provide certs)
# TLS_CERT_PATH=/etc/certs/fullchain.pem
# TLS_KEY_PATH=/etc/certs/privkey.pem
